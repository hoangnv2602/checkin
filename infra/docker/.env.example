# infra/docker/.env.example — I-008
# Copy sang .env (KHÔNG commit) rồi chỉnh giá trị nếu cần.
# .env đã được .gitignore loại trừ.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_checkin
POSTGRES_PORT=5432

REDIS_PORT=6379

MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# I-107 — Platform admin seed (dev only; rotate in prod)
PLATFORM_ADMIN_SEED_EMAIL=owner@saas-checkin.com
PLATFORM_ADMIN_SEED_PASSWORD=PlatformP@ss123!

# BFF dev: IP allowlist for /v1/admin/* routes
PLATFORM_ADMIN_IP_ALLOWLIST=127.0.0.1/32,::1/128
