{
  "name": "@saas-checkin/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "gen": "tsx scripts/generate.ts",
    "gen:web": "openapi-typescript ../contracts/openapi.json -o ./src/gen/web.ts",
    "gen:mobile": "openapi-generator-cli generate -i ../contracts/openapi.json -g dart -o ./src/gen/mobile/"
  },
  "dependencies": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "openapi-typescript": "7.13.0",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "tsx": "4.23.12",
    "typescript": "5.7.2"
  }
}
