{
  "name": "@saas-checkin/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "gen": "tsx scripts/generate.ts",
    "gen:web": "openapi-typescript ../contracts/openapi.json -o ./src/gen/web.ts",
    "gen:mobile": "openapi-generator-cli generate -i ../contracts/openapi.json -g dart -o ./src/gen/mobile/"
  },
  "dependencies": {
    "axios": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "openapi-typescript": "7.4.4",
    "@openapitools/openapi-generator-cli": "2.16.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
