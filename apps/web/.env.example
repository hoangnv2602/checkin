# apps/web — local dev env
# Copy to .env.local và chỉnh nếu cần.

# Public URL của web app (browser dùng). Default http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SSR server-to-server gọi BFF (api-gateway). Docker: http://api-gateway:3001.
# KHÔNG có NEXT_PUBLIC_ prefix → chỉ readable từ server, không leak ra client.
INTERNAL_API_URL=http://localhost:3001
