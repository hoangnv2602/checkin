# API Gateway environment (placeholders — real values via Doppler / Vault)

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Core API
CORE_API_BASE=http://core-api:5050
GRPC_TARGET=core-api:50051
GRPC_SERVER_ENABLED=true
GRPC_SERVER_PORT=50052

# Redis
REDIS_URL=redis://redis:6380

# JWT (RS256)
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=

# OpenTelemetry / Sentry (I-603)
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_SERVICE_NAME=api-gateway
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# Checkin-admin IP allowlist (I-107) — comma-separated CIDR.
# In production, leaving this UNSET will reject ALL requests to /v1/admin/*.
# In development/staging, the guard is bypassed when this is unset to allow
# the first-time login bootstrap. Examples:
#   127.0.0.1/32,::1/128             # local dev only
#   203.0.113.0/24,2001:db8::/32     # office VPN range
PLATFORM_ADMIN_IP_ALLOWLIST=
PLATFORM_ADMIN_REFRESH_TTL_HOURS=8
