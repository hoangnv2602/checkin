<Project>
  <!--
    Directory.Build.props — applied to ALL projects under apps/core-api.
    Enforce: nullable on, warnings as errors, C# 14, ImplicitUsings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>  <!-- missing XML doc -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- CA1716: "Shared" namespace conflicts with reserved keyword — namespace intentional -->
    <!-- CA1305: IFormatProvider — Serilog Console() sink default is fine for Phase 0 -->
    <!-- CA1848: LoggerMessage delegates — Phase 1 use simple LogInformation; optimize Phase 6+ -->
    <!-- CA1873: log arg evaluation — keep simple, suppress for Phase 1 -->
    <!-- CA1826: use collection indexer directly — keep code style, suppress -->
    <!-- CA1822: mark static — keep API, suppress -->
    <!-- CA1711: type names should not end in 'Permission' — IRequirePermission is intentional -->
    <!-- CA1725: param name 'ct' vs 'cancellationToken' — keep 'ct' brevity -->
    <!-- CA1707: test method names with underscores — convention for BDD-style test naming -->
    <!-- CA1861: constant array arguments — generated EF migrations pass new[] { ... }; refactor is not worth it -->
    <NoWarn>$(NoWarn);CA1716;CA1305;CA1848;CA1873;CA1826;CA1822;CA1711;CA1725;CA1707;CA1861</NoWarn>
  </PropertyGroup>
</Project>
