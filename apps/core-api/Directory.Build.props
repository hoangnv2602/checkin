<Project>
  <!--
    Directory.Build.props — applied to ALL projects under apps/core-api.
    Enforce: nullable on, warnings as errors, C# 14, ImplicitUsings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>  <!-- missing XML doc -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- CA1716: "Shared" namespace conflicts with reserved keyword — namespace intentional -->
    <!-- CA1305: IFormatProvider — Serilog Console() sink default is fine for Phase 0 -->
    <NoWarn>$(NoWarn);CA1716;CA1305</NoWarn>
  </PropertyGroup>
</Project>
