# .editorconfig — I-002
# Consistent formatting across editors. StyleCop + .NET analyzers sẽ enforce
# thêm cho C#; prettier/eslint enforce cho TS.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,sln,props,targets}]
indent_size = 4

[*.{proto,go,rs,java,kt}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
